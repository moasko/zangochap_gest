# Database and authentication
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
JWT_SECRET="replace-with-a-long-random-secret"

# WhatsApp Business Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN="permanent-system-user-token"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN="replace-with-a-long-random-value"
WHATSAPP_APP_SECRET=""
WHATSAPP_GRAPH_API_VERSION="v23.0"


# Optional: server-only reverse geocoding for rider map place names.
GEOAPIFY_API_KEY=

# Optional direct/session PostgreSQL URL for LISTEN (same database as DATABASE_URL).
# Leave empty when DATABASE_URL is already a direct connection.
RIDER_STREAM_DATABASE_URL=
