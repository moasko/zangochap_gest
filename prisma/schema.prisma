generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DEVELOPER
  ADMIN
  COMPTABLE
  COMMERCIAL
  PACKING
  COLLECTION
  STOCK
  POINT_RELAIS
  CUSTOMER
  LIVREUR
}

enum OrderStatus {
  PENDING
  TO_PROCESS
  CONFIRMED
  PACKED
  PARTIAL
  DELIVERED
  CANCELLED
  COLLECTED
  UNAVAILABLE
  ALTERNATIVE
  SENT
  ON_DELIVERY
  RETURNED
  EXCHANGED
  REPROGRAMMED
  REPRO_DISPO
  PREPARING
  PARTIALLY_DELIVERED
}

enum MovementType {
  SALE
  RESTOCK
  RETURN
  EXCHANGE
  ADJUSTMENT
  DAMAGE
  LOSS
}

enum PackingItemStatus {
  PENDING
  PACKED
  NOT_PACKED
}

enum GiftApprovalStatus {
  APPROVED
  PENDING
  REJECTED
  CANCELLED
}

enum SettlementStatus {
  PENDING
  COMPLETED
  PARTIAL
}

enum PromoType {
  PERCENT
  FIXED
  GIFT
}

enum PromoRule {
  ONCE_PER_PHONE
  ONCE_PER_CUSTOMER
  UNLIMITED
}

enum ChatMessageScope {
  GENERAL
  ROLE
  DIRECT
}

enum AccountingOperationType {
  INCOME
  EXPENSE
  CORRECTION
}

enum AccountingOperationSource {
  DELIVERY
  CUSTOMER
  MANUAL
  OTHER
}

enum AccountingCategoryType {
  INCOME
  EXPENSE
}

enum AccountingSessionStatus {
  OPEN
  CLOSED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  phone        String?      @unique
  name         String
  password     String
  role         Role         @default(COMMERCIAL)
  initials     String?
  phone2       String? // Second numéro
  serviceLabel String? // Libellé si numéro de service
  isPaused     Boolean      @default(false)
  giftMonthlyQuota      Int @default(0)
  giftMonthlyValueQuota Int @default(0)
  pausedAt     DateTime?
  pauseReason  String?
  orders       Order[]      @relation("CommercialOrders")
  products     Product[]    @relation("CreatedProducts")
  settlements  Settlement[] @relation("DeliverySettlements")
  sentChatMessages     ChatMessage[] @relation("ChatMessageSender")
  receivedChatMessages ChatMessage[] @relation("ChatMessageRecipient")
  chatReads            ChatRead[]
  createdAt    DateTime     @default(now())
}

model ChatMessage {
  id           String           @id @default(cuid())
  body         String           @db.Text
  scope        ChatMessageScope @default(GENERAL)
  targetRole   Role?
  recipientId  String?
  recipient    User?           @relation("ChatMessageRecipient", fields: [recipientId], references: [id])
  senderId     String?
  sender       User?            @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  senderName   String
  senderRole   Role
  isPinned     Boolean          @default(false)
  deletedAt    DateTime?
  editedAt     DateTime?
  createdAt    DateTime         @default(now())
  reads        ChatRead[]

  @@index([scope])
  @@index([targetRole])
  @@index([recipientId])
  @@index([senderId])
  @@index([createdAt])
  @@index([deletedAt])
}

model ChatRead {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime    @default(now())

  @@unique([messageId, userId])
  @@index([userId])
  @@index([readAt])
}

model DeveloperAuditLog {
  id        String   @id @default(cuid())
  action    String
  status    String
  actorId   String?
  actorName String?
  actorEmail String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([status])
  @@index([createdAt])
}

model AccountingSession {
  id          String                  @id @default(cuid())
  date        DateTime                @unique
  status      AccountingSessionStatus @default(OPEN)
  notes       String?                 @db.Text
  // Date de traitement saisie manuellement a la cloture : le jour ou la caisse a
  // ete reellement traitee/rapprochee (peut differer du jour comptable "date").
  processedAt   DateTime?
  processedByName String?
  operations  AccountingOperation[]
  audits      AccountingAuditLog[]
  reports     AccountingReport[]      @relation("AccountingReportSessions")
  createdById String?
  createdByName String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([date])
  @@index([status])
}

model AccountingCategory {
  id         String                  @id @default(cuid())
  name       String
  slug       String
  type       AccountingCategoryType
  isDefault  Boolean                 @default(false)
  operations AccountingOperation[]
  reports    AccountingReport[]      @relation("AccountingReportCategories")
  createdById String?
  createdByName String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@unique([slug, type])
  @@index([type])
}

model AccountingOperation {
  id             String                    @id @default(cuid())
  type           AccountingOperationType
  source         AccountingOperationSource @default(MANUAL)
  amount         Int
  originalAmount Int?
  description    String?                   @db.Text
  proofUrl       String?                   @db.Text
  reason         String?                   @db.Text
  sessionId      String
  session        AccountingSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  categoryId     String
  category       AccountingCategory        @relation(fields: [categoryId], references: [id])
  groupId        String?
  group          AccountingGroup?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  deliveryOrderId String?
  deliveryOrderRef String?
  customerId     String?
  clientName     String?
  riderId        String?
  riderName      String?
  createdById    String?
  createdByName  String?
  updatedById    String?
  updatedByName  String?
  audits         AccountingAuditLog[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([source, deliveryOrderId])
  @@index([sessionId])
  @@index([categoryId])
  @@index([type])
  @@index([source])
  @@index([customerId])
  @@index([createdAt])
  @@index([groupId])
}

model AccountingAuditLog {
  id          String               @id @default(cuid())
  action      String
  entityType  String
  entityId    String?
  sessionId   String?
  session     AccountingSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  operationId String?
  operation   AccountingOperation? @relation(fields: [operationId], references: [id], onDelete: SetNull)
  actorId     String?
  actorName   String?
  actorEmail  String?
  previousAmount Int?
  newAmount      Int?
  reason      String?              @db.Text
  details     Json?
  createdAt   DateTime             @default(now())

  @@index([entityType, entityId])
  @@index([sessionId])
  @@index([operationId])
  @@index([createdAt])
}

model AccountingReport {
  id          String                 @id @default(cuid())
  name        String
  description String?                @db.Text
  dateFrom    DateTime
  dateTo      DateTime
  operationTypes String[]
  filters     Json?
  totalIncome  Int                   @default(0)
  totalExpense Int                   @default(0)
  balance      Int                   @default(0)
  operationsCount Int                @default(0)
  sessions    AccountingSession[]    @relation("AccountingReportSessions")
  categories  AccountingCategory[]   @relation("AccountingReportCategories")
  createdById String?
  createdByName String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([dateFrom, dateTo])
  @@index([createdAt])
}

model AccountingGroup {
  id            String               @id @default(cuid())
  name          String
  description   String?              @db.Text
  color         String?              // hex color e.g. "#D4541C"
  operations    AccountingOperation[]
  totalIncome   Int                  @default(0)
  totalExpense  Int                  @default(0)
  balance       Int                  @default(0)
  createdById   String?
  createdByName String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([createdAt])
}

model StockMovement {
  id          String         @id @default(cuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  warehouseId String?
  warehouse   Warehouse?     @relation(fields: [warehouseId], references: [id])
  type        MovementType
  quantity    Int // positive for restock, negative for sale
  reason      String?
  orderId     String? // if linked to an order
  by          String // userId or email
  byName      String
  createdAt   DateTime       @default(now())

  @@index([variantId])
  @@index([createdAt])
}

model Settlement {
  id                 String           @id @default(cuid())
  deliverymanId      String
  deliveryman        User             @relation("DeliverySettlements", fields: [deliverymanId], references: [id])
  amount             Int
  productsAmount     Int              @default(0)
  deliveryFeesAmount Int              @default(0)
  ordersCount        Int
  status             SettlementStatus @default(PENDING)
  notes              String?
  by                 String // admin who validated
  orders             Order[]          @relation("OrderSettlement")
  createdAt          DateTime         @default(now())
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  slug          String        @unique
  products      Product[]
  subCategories SubCategory[]
  promoCodes    PromoCode[]   @relation("PromoCategories")
  createdAt     DateTime      @default(now())
}

model SubCategory {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  products   Product[]
  createdAt  DateTime  @default(now())

  @@unique([name, categoryId])
}

model Supplier {
  id        String    @id @default(cuid())
  name      String    @unique
  contact   String?
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id                String           @id @default(cuid())
  name              String
  slug              String           @unique @default(cuid())
  ref               String?          @unique
  emoji             String?          @default("📦")
  description       String?
  price             Decimal          @db.Decimal(10, 2)
  oldPrice          Decimal?         @db.Decimal(10, 2)
  category          Category?        @relation(fields: [categoryId], references: [id])
  categoryId        String?
  subCategory       SubCategory?     @relation(fields: [subCategoryId], references: [id])
  subCategoryId     String?
  material          String?
  origin            String?
  stock             Int              @default(0)
  lowStockThreshold Int              @default(5)
  location          String?
  supplier          Supplier?        @relation(fields: [supplierId], references: [id])
  supplierId        String?
  sentToSupplierAt  DateTime?
  images            ProductImage[]
  variants          ProductVariant[]
  mainImageId       String?
  status            ProductStatus    @default(DRAFT)
  isFeatured        Boolean          @default(false)
  isGift            Boolean          @default(false)
  createdBy         User             @relation("CreatedProducts", fields: [creatorId], references: [id])
  creatorId         String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  orderItems        OrderItem[]
  promoCodes        PromoCode[]      @relation("PromoProducts")

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([supplierId])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  OUT_OF_STOCK
}

model ProductImage {
  id        String    @id @default(cuid())
  name      String
  url       String    @db.Text
  altText   String?
  position  Int       @default(0)
  width     Int?
  height    Int?
  size      Int?
  type      ImageType @default(GALLERY)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime  @default(now())

  @@index([productId, position])
}

enum ImageType {
  GALLERY
  THUMBNAIL
  BANNER
  FEATURED
}

model ProductVariant {
  id             String          @id @default(cuid())
  size           String
  color          String
  image          String?         @db.Text
  stock          Int             @default(0) // Stock global (somme des StockLevels)
  location       String? // Emplacement par défaut
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      String
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  orderItems     OrderItem[]
}

model Warehouse {
  id             String          @id @default(cuid())
  name           String          @unique
  location       String?
  isActive       Boolean         @default(true)
  stocks         StockLevel[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
}

model StockLevel {
  id          String         @id @default(cuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Int            @default(0)
  position    String? // Emplacement précis dans cet entrepôt (ex: Rang B, Etagère 2)

  @@unique([variantId, warehouseId])
}

model Order {
  id               String      @id @default(cuid())
  ref              String?     @unique
  deletedAt        DateTime?
  customerName     String
  customerPhone    String
  customerPhone2   String?
  customerLocation String?
  commune          String?
  total            Int
  deliveryFee      Int         @default(0)
  deliveryNote     String?
  type             String? // 'Echange', 'Récupération', 'Reprogrammé', 'Express'
  status           OrderStatus @default(PENDING)
  commercial       User?       @relation("CommercialOrders", fields: [commercialId], references: [id])
  commercialId     String?
  commercialName   String?
  items            OrderItem[]
  promoCode        String?
  discount         Int         @default(0)
  notes            String?     @db.Text
  history          Json?
  packedBy         String?
  packedByName     String?
  packedAt         DateTime?
  confirmedAt      DateTime?
  confirmedByName  String?
  stockDecremented Boolean     @default(false)
  receiptSentAt    DateTime?
  customer         Customer?   @relation(fields: [customerId], references: [id])
  customerId       String?
  deliveryDate     DateTime?
  deliverymanId    String?
  deliverymanName  String?
  lastDeliveryAttemptAt     DateTime?
  lastDeliveryAttemptRiderId   String?
  lastDeliveryAttemptRiderName String?
  lastDeliveryAttemptStatus    String?
  lastDeliveryAttemptReason    String?
  deliveredAt      String? // ISO string for simple display
  paymentMethod    String? // MTN, Orange, Wave, etc.
  amountReceived   Int?

  settlement   Settlement? @relation("OrderSettlement", fields: [settlementId], references: [id])
  settlementId String?

  isCommercialContacted Boolean @default(false)
  commercialContactedAt DateTime?
  commercialContactedByName String?
  commercialContactOutcome String?
  commercialContactReport String? @db.Text
  returnReason          String?
  hasIssue              Boolean @default(false)
  issueType             String?

  isLabeled             Boolean   @default(false)
  labeledAt             DateTime?
  labeledByName         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerPhone])
  @@index([commercialId])
  @@index([lastDeliveryAttemptAt])
  @@index([lastDeliveryAttemptRiderId])
  @@index([createdAt])
}

model OrderItem {
  id          String    @id @default(cuid())
  name        String
  size        String
  color       String
  qty         Int
  price       Int
  emoji       String?
  image       String?   @db.Text
  isCustom    Boolean   @default(false)
  isGift      Boolean   @default(false)
  giftCountsTowardQuota Boolean @default(true)
  giftUnitValue Int @default(0)
  giftApprovalStatus GiftApprovalStatus?
  notes       String?   @db.Text
  isVerified  Boolean   @default(false)
  verifiedAt  DateTime?
  packingStatus PackingItemStatus @default(PENDING)
  isDelivered Boolean   @default(true)
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product?  @relation(fields: [productId], references: [id])
  productId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId   String?

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model GiftApprovalRequest {
  id             String             @id @default(cuid())
  commercialId   String
  commercialName String
  orderId        String
  orderRef       String?
  orderItemId    String             @unique
  giftName       String
  quantity       Int
  unitValue      Int                @default(0)
  reason         String             @db.Text
  status         GiftApprovalStatus @default(PENDING)
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  reviewNote     String?            @db.Text
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([commercialId, createdAt])
  @@index([status, createdAt])
  @@index([orderId])
}

model CollectionRecord {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  status    String // collected, unavailable, alternative
  by        String
  byName    String
  createdAt DateTime @default(now())
}

model PromoCode {
  code          String       @id
  label         String?
  type          PromoType
  value         Int          @default(0)
  giftProductId String?
  rule          PromoRule    @default(UNLIMITED)
  minAmount     Int          @default(0)
  maxGlobalUses Int?
  startDate     DateTime?
  endDate       DateTime?
  isActive      Boolean      @default(true)
  isAutomatic   Boolean      @default(false)
  minQuantity   Int          @default(0)
  products      Product[]    @relation("PromoProducts")
  categories    Category[]   @relation("PromoCategories")
  creatorId     String
  createdAt     DateTime     @default(now())
  usages        PromoUsage[]
}

model PromoUsage {
  id            String    @id @default(cuid())
  promoCode     String
  promo         PromoCode @relation(fields: [promoCode], references: [code])
  orderId       String    @unique
  customerName  String
  customerPhone String
  orderTotal    Float
  createdAt     DateTime  @default(now())

  @@index([promoCode])
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String   @unique
  phone2      String?
  location    String?
  commune     String?
  orders      Order[]
  totalOrders Int      @default(0)
  totalSpent  Int      @default(0)
  lastOrderAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Commune {
  id          String   @id @default(cuid())
  name        String   @unique
  deliveryFee Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model CmsContent {
  key       String   @id
  data      Json
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
